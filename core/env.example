# Copiloto Comercios — Core
# Copiar a .env y completar. El .env NUNCA se commitea.

PORT=8080
APP_ENV=development

# El puerto host es 5433 (el 5432 lo ocupa otro postgres local)
DATABASE_URL=postgres://copiloto:copiloto@localhost:5433/copiloto?sslmode=disable
REDIS_URL=redis://localhost:6379/0
MIGRATIONS_PATH=migrations

# Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION_HOURS=8
JWT_REFRESH_HOURS=24

ALLOWED_ORIGINS=http://localhost:5173

ARCA_SIDECAR_URL=http://localhost:8001
# Debe coincidir con INTERNAL_API_TOKEN del sidecar
INTERNAL_API_TOKEN=

# Cifra en reposo los certificados de ARCA (AES-256-GCM). 64 caracteres hex.
# Generar con: openssl rand -hex 32
# Sin esto el modulo fiscal queda apagado: no se pueden cargar certificados ni
# facturar. Si se rota, hay que volver a cargar los certificados de cada
# negocio: los viejos dejan de descifrarse.
FISCAL_CIPHER_KEY=
