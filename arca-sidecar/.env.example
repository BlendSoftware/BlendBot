# ─────────────────────────────────────────────────────────────────────────────
# Sidecar ARCA — variables de entorno (EJEMPLO)
# Copiar a .env. Acá NO van certificados: llegan por request desde el core.
# ─────────────────────────────────────────────────────────────────────────────

# Secreto compartido con el core. Obligatorio si ARCA_MODO_DEFAULT=produccion.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_TOKEN=dev-token-cambiame

# Puerto HTTP
ARCA_PORT=8001

# Sólo decide si INTERNAL_API_TOKEN es obligatorio y si /docs se publica.
# El modo real de cada factura (homologacion|produccion) viene en el body.
ARCA_MODO_DEFAULT=homologacion

# Directorio de trabajo: certs materializados por tenant, tickets y cache WSDL
ARCA_CACHE_DIR=/tmp/arca_cache

# Máximo de tenants con cliente vivo en memoria (LRU)
ARCA_MAX_TENANTS_CACHE=50

# Opcional: persiste el token WSAA entre reinicios (recomendado en prod)
# REDIS_URL=redis://redis:6379/0

# Publicar /docs (sólo en desarrollo)
ARCA_DOCS=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
