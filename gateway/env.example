# Gateway de WhatsApp — copiá a .env y completá. El .env NO va al repo.

PORT=8090
REDIS_URL=redis://localhost:6379

# ── Meta / WhatsApp Cloud API ────────────────────────────────────────────────
# App secret de la app de Meta: con esto se verifica X-Hub-Signature-256.
META_APP_SECRET=
# Lo inventás vos y lo pegás igual en la config del webhook en Meta.
META_VERIFY_TOKEN=
# Token de sistema con permiso whatsapp_business_messaging.
META_GRAPH_TOKEN=
# Sólo para apuntar a un mock en desarrollo.
# GRAPH_URL=https://graph.facebook.com/v21.0

# ── Core y agente ────────────────────────────────────────────────────────────
CORE_URL=http://localhost:8080
TENANTS_PATH=./tenants.json
SESIONES_DIR=./data/sesiones
# Vacío = subdirectorio de SESIONES_DIR ("./data/sesiones/borradores"). El
# agente espeja ahí el borrador y el hold entre procesos MCP (uno por mensaje).
BORRADORES_DIR=

ANTHROPIC_API_KEY=
MODELO=claude-haiku-4-5-20251001

# Alternativa a ANTHROPIC_API_KEY: OpenRouter (o cualquier gateway compatible
# con la API de Anthropic). Dejá ANTHROPIC_API_KEY vacía y usá el id de modelo
# de OpenRouter, por ejemplo MODELO=anthropic/claude-haiku-4.5.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
