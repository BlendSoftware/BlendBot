# Copiloto Comercios — entorno del docker-compose de la raíz.
#
#   cp env.compose.example .env
#
# (sin punto en el ejemplo, igual que core/env.example y gateway/env.example;
# el archivo que lee docker compose sí se llama `.env` y está en .gitignore)
#
# Este archivo NUNCA lleva un secreto real. Todo lo de acá lo lee docker
# compose y se lo pasa a los servicios; docs/DEPLOY.md explica qué hace cada
# variable.
#
# Gotcha: `docker compose restart` no relee este archivo.
# Después de tocarlo: `docker compose up -d --force-recreate`.

# ── General ──────────────────────────────────────────────────────────────────
# development | production.
# En `production` el gateway EXIGE las credenciales de Meta y de Anthropic y no
# arranca sin ellas. En `development` arranca degradado y lo avisa.
APP_ENV=development

# ── Core ─────────────────────────────────────────────────────────────────────
# Firma los JWT del panel. 32 caracteres como mínimo o el core no arranca.
# Generar con: openssl rand -hex 32
JWT_SECRET=

# Contraseña del admin inicial de la plataforma. Se usa UNA vez: si ya existe
# un usuario admin en la base, esto se ignora.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Orígenes permitidos por CORS. El panel detrás de su nginx es same-origin y no
# lo necesita; esto es para el `npm run dev` de la máquina.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173

# ── Fiscal (ARCA) ────────────────────────────────────────────────────────────
# Cifra en reposo los certificados de ARCA (AES-256-GCM), 64 caracteres hex.
# Generar con: openssl rand -hex 32
# VACÍA = módulo fiscal APAGADO: se cobra igual, pero no se emite factura. Es
# lo correcto en desarrollo, donde no hay certificados de ARCA.
# Si se rota, hay que volver a cargar los certificados de cada negocio: los
# viejos dejan de descifrarse.
FISCAL_CIPHER_KEY=

# Autentica las llamadas core → sidecar. Tiene que ser el MISMO valor en los
# dos (el compose ya se encarga de eso).
INTERNAL_API_TOKEN=

# homologacion | produccion
ARCA_MODO_DEFAULT=homologacion

# ── Gateway de WhatsApp ──────────────────────────────────────────────────────
# App de Meta. Sin META_APP_SECRET el webhook rechaza TODO con 401 (correcto:
# sin firma verificable, cualquiera podría hacerle hablar al agente).
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_TOKEN=

# API key de Anthropic. El OAuth personal NO sirve: usarlo para atender
# clientes viola el ToS de Anthropic.
ANTHROPIC_API_KEY=
MODELO=claude-haiku-4-5-20251001

# Mapa phone_number_id → negocio. Copiá gateway/tenants.example.json, poné los
# tokens `cop_` que devuelve el core y apuntá esto al archivo.
GATEWAY_TENANTS_FILE=./gateway/tenants.example.json

# ── Puertos publicados en el host ────────────────────────────────────────────
CORE_PORT=8080
ARCA_PORT=8001
GATEWAY_PORT=8090
PANEL_PORT=8081
